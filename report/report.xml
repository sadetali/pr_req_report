<odoo>
    <record id="paperformat_pr_req" model="report.paperformat">
        <field name="name">Product Request A4</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">5</field>
        <field name="margin_bottom">8</field>
        <field name="margin_left">10</field>
        <field name="margin_right">10</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
        <field name="disable_shrinking" eval="True"/>
    </record>

    <record id="action_product_request_report" model="ir.actions.report">
        <field name="name">Product Request</field>
        <field name="model">stock.picking</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">pr_req_report.rpt</field>
        <field name="report_file">pr_req_report.rpt</field>
        <field name="binding_model_id" ref="stock.model_stock_picking"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="paperformat_pr_req"/>
        <field name="print_report_name">'Product Request - %s' % (object.name or '')</field>
    </record>
</odoo>
