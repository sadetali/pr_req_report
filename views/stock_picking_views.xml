<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_stock_picking_form_internal_variant" model="ir.ui.view">
        <field name="name">stock.picking.form.internal.variant</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='move_ids_without_package']/list/field[@name='product_id']" position="after">
                <field name="x_internal_variant_id"
                       optional="show"
                       domain="[('product_tmpl_id', '=', product_id.product_tmpl_id)]"/>
            </xpath>

        </field>
    </record>

</odoo>
